{
  "name": "lose-as-a-service",
  "version": "1.0.0",
  "description": "API local em TypeScript para retornar mensagens aleatorias sobre perder o Jogo.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "typescript",
    "express",
    "swagger",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/node": "^24.7.2",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
